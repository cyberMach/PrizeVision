{
  "expo": {
    "name": "PrizeVision",
    "slug": "prizevision",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "prizevision",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0C3B2E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.prizevision.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Kupon taramak için kamera gerekli",
        "NSPhotoLibraryUsageDescription": "Kupon fotoğrafı seçmek için galeri erişimi gerekli"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C3B2E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.prizevision.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-notifications",
        { "color": "#FFBA00" }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
